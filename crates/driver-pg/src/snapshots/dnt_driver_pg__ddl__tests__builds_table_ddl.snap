---
source: crates/driver-pg/src/ddl.rs
expression: build_table_ddl(&sample())
---
CREATE TABLE public.events (
    id bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
    "we""ird" text,
    amount numeric(12,2) NOT NULL DEFAULT 0,
    amount_tax numeric GENERATED ALWAYS AS (round((amount * 1.1), 2)) STORED,
    customer_id integer NOT NULL,
    created_at date NOT NULL,
    "Seq" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    CONSTRAINT events_pkey PRIMARY KEY (id, created_at),
    CONSTRAINT events_customer_uq UNIQUE (customer_id, created_at),
    CONSTRAINT events_amount_check CHECK ((amount >= (0)::numeric)),
    CONSTRAINT events_customer_id_fkey FOREIGN KEY (customer_id) REFERENCES sales.customers (id) ON DELETE CASCADE
) PARTITION BY RANGE (created_at);
CREATE INDEX idx_events_amount ON public.events USING btree (amount);
COMMENT ON TABLE public.events IS 'Event log';
COMMENT ON COLUMN public.events."we""ird" IS 'it''s odd';
